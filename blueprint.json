{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Kiln & Crumb demo",
		"description": "Block theme for a fictional neighborhood bakery, with demo content.",
		"author": "Ibrahem-al"
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"steps": [
		{
			"step": "installTheme",
			"themeData": {
				"resource": "git:directory",
				"url": "https://github.com/Ibrahem-al/kiln-crumb",
				"ref": "main",
				"path": "theme/kiln-crumb"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "setSiteOptions",
			"options": {
				"permalink_structure": "/%postname%/"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; require_once get_theme_file_path( 'inc/demo-content.php' ); kc_create_demo_content(); flush_rewrite_rules();"
		}
	]
}
