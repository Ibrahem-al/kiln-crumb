{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "680px",
			"wideSize": "1180px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "cream", "name": "Cream", "color": "#FBF5EC" },
				{ "slug": "paper", "name": "Paper", "color": "#F2E6D3" },
				{ "slug": "ink", "name": "Ink", "color": "#2A1F18" },
				{ "slug": "muted", "name": "Muted ink", "color": "#5E4E43" },
				{ "slug": "crust", "name": "Crust", "color": "#8C3B14" },
				{ "slug": "crust-dark", "name": "Crust (hover)", "color": "#6E2C0C" },
				{ "slug": "sage", "name": "Sage", "color": "#4B5A41" },
				{ "slug": "butter", "name": "Butter", "color": "#F0C96A" },
				{ "slug": "line", "name": "Hairline", "color": "#D9C8B0" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Fraunces",
					"fontFamily": "Fraunces, 'Iowan Old Style', Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "300 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fraunces-latin-wght-normal.woff2" ]
						},
						{
							"fontFamily": "Fraunces",
							"fontStyle": "italic",
							"fontWeight": "300 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fraunces-latin-wght-italic.woff2" ]
						}
					]
				},
				{
					"slug": "body",
					"name": "Inter",
					"fontFamily": "Inter, system-ui, -apple-system, 'Segoe UI', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter-latin-wght-normal.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.3rem", "fluid": { "min": "1.15rem", "max": "1.3rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2rem", "fluid": { "min": "1.6rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "name": "Display", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4.5rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 2.5vw, 1.75rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 7vw, 6rem)" }
			]
		},
		"shadow": {
			"defaultPresets": false
		},
		"custom": {
			"lineHeight": { "tight": "1.1", "body": "1.65" }
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--cream)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(1rem, 4vw, 2.5rem)",
				"right": "clamp(1rem, 4vw, 2.5rem)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "var(--wp--custom--line-height--body)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "500",
					"lineHeight": "var(--wp--custom--line-height--tight)",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--crust)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--crust-dark)" }
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--crust)",
					"text": "var(--wp--preset--color--cream)"
				},
				"border": { "radius": "999px" },
				"spacing": {
					"padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "1.4rem", "right": "1.4rem" }
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600",
					"textDecoration": "none"
				},
				":hover": {
					"color": { "background": "var(--wp--preset--color--crust-dark)" }
				},
				":focus": {
					"color": { "background": "var(--wp--preset--color--crust-dark)" }
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "1.45rem",
					"fontWeight": "600",
					"letterSpacing": "-0.01em"
				},
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--ink)" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "500" },
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--ink)" },
						"typography": { "textDecoration": "none" },
						":hover": { "typography": { "textDecoration": "underline" } }
					}
				}
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--line)" }
			},
			"core/button": {
				"variations": {
					"outline": {
						"color": {
							"background": "transparent",
							"text": "var(--wp--preset--color--crust)"
						},
						"border": { "width": "2px", "color": "var(--wp--preset--color--crust)" }
					}
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-no-title", "title": "Page without title", "postTypes": [ "page" ] }
	]
}
